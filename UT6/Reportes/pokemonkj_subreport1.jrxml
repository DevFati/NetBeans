	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
	<summary>
		<band height="273" splitType="Stretch">
			<barChart>
				<chart>
					<reportElement x="11" y="10" width="544" height="248" uuid="2ef4f731-41ba-40b5-bc33-c8dec6b83878"/>
