<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pokemonkj_subreport1" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a9a1314c-6628-434c-ab88-e31623df3bdc">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[SELECT 
    p.region AS region,
    COUNT(DISTINCT p.id) AS total_pokemons_unicos
FROM 
    pokemon_movimientos pm
JOIN 
    pokemons p ON pm.pokemon_id = p.id
GROUP BY 
    p.region
ORDER BY 
    p.region;
]]>
	</queryString>
	<field name="region" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="total_pokemons_unicos" class="java.lang.Long"/>
	<background>
		<band splitType="Stretch"/>
	</background>
