		<defaultValueExpression><![CDATA["C:\\Users\\Fatima\\Documents\\CURSO24_25DAM\\NetBeans\\UT6\\Reportes\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    p.region AS region,
    p.nombre AS pokemon_nombre,
    m.nombre AS movimiento_nombre,
    pm.nivel_aprendizaje
	
FROM 
    pokemon_movimientos pm
JOIN 
    pokemons p ON pm.pokemon_id = p.id
JOIN 
    movimientos m ON pm.movimiento_id = m.id

ORDER BY 
    p.region, p.id, pm.nivel_aprendizaje;
]]>
	</queryString>
	<field name="region" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
