	</parameter>
	<queryString>
		<![CDATA[SELECT v.id_venta, c.nombre AS cliente, c.apellido AS cliente_apellido, 
       ve.marca, ve.modelo, ve.anio, v.fecha_venta, v.precio_final, 
       v.id_empleado
FROM Ventas v
JOIN Clientes c ON v.id_cliente = c.id_cliente
JOIN Vehiculos ve ON v.id_vehiculo = ve.id_vehiculo
 AND v.id_venta = $P{VentaID};

]]>
	</queryString>
