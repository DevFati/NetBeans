<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informeprincipal_subreport_" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="7a55b018-afaa-466d-b6b0-f465d8557b3c">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="VentaID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT v.id_venta, e.nombre AS empleado, e.apellido AS empleado_apellido, e.cargo
FROM Ventas v
JOIN Empleados e ON v.id_empleado = e.id_empleado
WHERE v.id_venta = $P{VentaID};
]]>
	</queryString>
	<field name="id_venta" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="empleado" class="java.lang.String"/>
	<field name="empleado_apellido" class="java.lang.String"/>
	<field name="cargo" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<background>
		<band splitType="Stretch"/>
	</background>
