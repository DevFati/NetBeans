	<parameter name="PokemonID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT pm.PokemonID, m.Nombre AS Movimiento, m.Tipo, m.Poder, m.Precisión, pm.NivelAprendido
FROM Pokemon_Movimiento pm
JOIN Movimiento m ON pm.MovimientoID = m.MovimientoID
WHERE pm.PokemonID = $P{PokemonID}]]>
	</queryString>
